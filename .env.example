# --- RAG / ChromaDB ---
# Índice vetorial persistente (pasta local). Só reindexa PDFs se estiver vazia ou se o manifest mudar.
# CHROMA_PERSIST_DIR=data/vector_db
# Trechos enviados ao LLM por pergunta (economia de tokens na resposta).
# ROTINA_RAG_TOP_K=3

# --- CONFIGURAÇÃO DE IA (OpenRouter) ---
ROTINA_CHAT_PROVIDER=openrouter
ROTINA_EMBED_PROVIDER=openrouter

OPENROUTER_API_KEY=sk-or-v1-EXEMPLO_FICTICIO_SUBSTITUA_PELA_SUA_CHAVE
OPENAI_BASE_URL=https://openrouter.ai/api/v1
OPENAI_CHAT_MODEL=meta-llama/llama-3.3-70b-instruct

OPENAI_EMBED_MODEL=openai/text-embedding-3-small

# Identificação para o OpenRouter
OPENROUTER_HTTP_REFERER=https://github.com/exemplo-usuario/Rotina-Viva
OPENROUTER_APP_TITLE=Rotina Viva

# --- TRANSCRIÇÃO DE VOZ ---
# Se usar o container local do Whisper, defina a URL interna do serviço
OPENAI_TRANSCRIBE_BASE_URL=http://whisper:9000/v1

# --- CONFIGURAÇÕES DE NEGÓCIO (Relatórios) ---
ROTINA_SONO_MAX_MIN=60
ROTINA_SONO_FAIXA_LIMITE_1=20
ROTINA_SONO_FAIXA_LIMITE_2=40