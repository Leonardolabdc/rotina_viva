ROTINA_CHAT_PROVIDER=openrouter
ROTINA_EMBED_PROVIDER=openrouter

OPENROUTER_API_KEY=sk-or-v1-EXEMPLO_FICTICIO_SUBSTITUA_PELA_SUA_CHAVE
OPENAI_BASE_URL=https://openrouter.ai/api/v1
OPENAI_CHAT_MODEL=meta-llama/llama-3.3-70b-instruct

OPENAI_EMBED_MODEL=openai/text-embedding-3-small

OPENROUTER_HTTP_REFERER=https://github.com/exemplo-usuario/Rotina-Viva
OPENROUTER_APP_TITLE=Rotina Viva

# Transcrição por voz:
# — Com Docker Compose: o serviço `whisper` define OPENAI_TRANSCRIBE_BASE_URL (não precisa de chave local).
# — Só API OpenAI (sem container whisper): desative/ajuste o serviço whisper no compose e use:
# OPENAI_TRANSCRIBE_BASE_URL=https://api.openai.com/v1
# OPENAI_TRANSCRIBE_API_KEY=sk-...
# OPENAI_TRANSCRIBE_MODEL=whisper-1

# Relatório “Sono e alimentação”: teto de minutos contados (clip) e limites das faixas pouco / normal / bastante.
# ROTINA_SONO_MAX_MIN=60
# (Compat.) Se ROTINA_SONO_MAX_MIN estiver vazio, usa ROTINA_SONO_REFERENCIA_MIN como teto.
# ROTINA_SONO_FAIXA_LIMITE_1=20
# ROTINA_SONO_FAIXA_LIMITE_2=40
