# Copie para secrets.toml (local) ou cole no painel Streamlit Cloud → Settings → Secrets.
# Nunca commite secrets.toml com chaves reais.

OPENROUTER_API_KEY = "sk-or-v1-SUBSTITUA"
OPENAI_BASE_URL = "https://openrouter.ai/api/v1"
OPENAI_CHAT_MODEL = "meta-llama/llama-3.3-70b-instruct"
OPENAI_EMBED_MODEL = "openai/text-embedding-3-small"

ROTINA_CHAT_PROVIDER = "openrouter"
ROTINA_EMBED_PROVIDER = "openrouter"

OPENROUTER_HTTP_REFERER = "https://github.com/Leonardolabdc/Rotina-Viva"
OPENROUTER_APP_TITLE = "Rotina Viva"

# Agentes CrewAI (obrigatório para o toggle multi-agente)
ROTINA_ENABLE_CREWAI = "true"
CREWAI_DISABLE_TELEMETRY = "true"

# Laboratório FLAML consome muita RAM no tier gratuito — deixe false no Cloud
ROTINA_ENABLE_ML_LAB = "false"

# Langfuse (opcional)
ROTINA_LANGFUSE_ENABLED = "false"

# Voz: no Cloud não há container Whisper local. Deixe vazio para desactivar,
# ou aponte para Whisper na Oracle VM / OpenAI:
# OPENAI_TRANSCRIBE_BASE_URL = "https://SEU-VM/v1"
# OPENAI_TRANSCRIBE_API_KEY = "opcional-se-diferente"

# Indexação RAG mais rápida no 1.º arranque (opcional)
# ROTINA_MAX_CHUNKS_PER_PDF = "40"
# ROTINA_MAX_CHUNKS_TOTAL = "150"
